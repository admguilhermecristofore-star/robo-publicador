# Copie este arquivo para ".env" e preencha. NUNCA suba o .env para o Git.

# --- Google Sheets ---
SPREADSHEET_ID=ID_DA_PLANILHA
SHEET_NAME=Conteúdos
TIMEZONE=America/Sao_Paulo

# --- Google OAuth (arquivos na raiz do projeto) ---
GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_TOKEN_FILE=token.json

# --- Publicação ---
# Pasta dos vídeos (vazio = pasta 'videos' em 'Programar Conteúdos em Rede Social')
VIDEOS_DIR=
# Redes: youtube, instagram (perfil 1), instagram2 (perfil 2)
REDES_ATIVAS=instagram
YOUTUBE_PRIVACY=private
MAX_POR_EXECUCAO=5
# Sobe no YouTube com X horas de antecedência já PROGRAMADO para a Data Postar (0 = publica só na hora)
YOUTUBE_ANTECEDENCIA_HORAS=24

# --- Meta (Instagram / Facebook) ---
META_API_VERSION=v23.0
META_BUSINESS_ID=ID_DO_PORTFOLIO_META
# Cole abaixo o token do usuário do sistema "Publicador Reels" (vale para os 2 perfis)
META_TOKEN=
# Preenchidos pelo comando: python main.py descobrir-instagram
INSTAGRAM_ID_1=
META_TOKEN_1=
INSTAGRAM_ID_2=
META_TOKEN_2=
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_TOKEN=

# --- TikTok ---
# Kit de agendamento manual: quantos dias à frente mostrar
TIKTOK_DIAS=10
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=
TIKTOK_REFRESH_TOKEN=
